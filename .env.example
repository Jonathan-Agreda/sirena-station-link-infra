
# ============================================================
# SIRENA STATION LINK - ENVIRONMENT TEMPLATE
# Copy this file to .env for local development.
# Never commit real credentials.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

BACKEND_PUBLIC_URL=http://localhost:4000

# ============================================================
# POSTGRESQL - SUPERUSER
# ============================================================

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASS=CHANGE_ME

# ============================================================
# POSTGRESQL - BACKEND DATABASE
# ============================================================

POSTGRES_DB=sirena_db
POSTGRES_USER=sirena
POSTGRES_PASSWORD=CHANGE_ME

# ============================================================
# POSTGRESQL - KEYCLOAK DATABASE
# ============================================================

KC_DB=keycloak_db
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_DB_URL=jdbc:postgresql://postgres:5432/${KC_DB}

# ============================================================
# KEYCLOAK
# ============================================================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_REDIRECT_URI=

USER_DEFAULT_PASSWORD=CHANGE_ME

# ============================================================
# EMQX - MQTT BROKER
# ============================================================

EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASS=CHANGE_ME

MQTT_BACKEND_USER=srv-backend
MQTT_BACKEND_PASS=CHANGE_ME

EMQX_NODE_COOKIE=CHANGE_ME

# Optional device initialization
SEED_DEVICE_ID=SRN-001
SEED_DEVICE_APIKEY=CHANGE_ME

# ============================================================
# AUTHENTICATION - TOKENS
# ============================================================

ACCESS_TOKEN_TTL_SEC=540
REFRESH_TOKEN_TTL_SEC=3600

REFRESH_ROTATE_STRICT=true
REFRESH_MAX_REUSE=0

# ============================================================
# AUTHENTICATION - COOKIES
# ============================================================

REFRESH_COOKIE_NAME=ssr_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/api/auth/refresh
REFRESH_COOKIE_HTTPONLY=true

# ============================================================
# DEVICE COMMANDS
# ============================================================

DEFAULT_CMD_TTL_MS=300000

# ============================================================
# CORS - LOCAL DEVELOPMENT
# ============================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500,http://host.docker.internal:3000

# ============================================================
# SMTP - EMAIL
# ============================================================

MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_SECURE=true

MAIL_USER=
MAIL_PASS=

MAIL_FROM_NAME=SirenaStationLink
MAIL_FROM_EMAIL=

# ============================================================
# EMAIL BRANDING
# ============================================================

MAIL_BRAND_PRIMARY="#ef4444"
MAIL_BRAND_DARK="#0b1220"
MAIL_BRAND_ACCENT="#8b5cf6"

MAIL_LOGO_URL=

# ============================================================
# APPLICATION LINKS
# ============================================================

APP_LOGIN_URL=http://localhost:3000/login

# Development email helper
MAIL_DEV_ENABLED=false

# ============================================================
# TELEGRAM
# ============================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
